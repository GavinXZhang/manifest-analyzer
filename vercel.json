{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "rewrites": [{ "source": "/(.*)", "destination": "/api/app" }],
  "functions": {
    "api/app.mjs": {
      "includeFiles": "{web/dist/**,src/ui/public/**}",
      "maxDuration": 30
    }
  }
}
